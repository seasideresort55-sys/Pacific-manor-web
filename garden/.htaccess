DirectoryIndex index.php
RewriteEngine On
RewriteBase /garden/
RewriteRule ^(src|migrate|tests)(/|$) - [F,L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^_deploy_[A-Za-z0-9]+\.php$ - [R=404,L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^_shipmonth_[A-Za-z0-9]+\.php$ - [R=404,L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L]
